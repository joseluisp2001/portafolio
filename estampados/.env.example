# Copiar a .env y llenar.

# Usuario y clave del panel. Las DOS hacen falta: sin cualquiera de las dos, el
# middleware falla cerrado y el panel no abre.
# Elegi un usuario que no sea "admin": tenerlo fijo regala media credencial.
ADMIN_USER=
ADMIN_PASSWORD=

# Dominio, con https y sin barra final. Se hornea AL COMPILAR.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
