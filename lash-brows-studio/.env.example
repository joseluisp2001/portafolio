# ============================================================================
#  GÉNESIS ROCA · LASH & BROW STUDIO — variables de entorno
#
#  Copiá este archivo como `.env.local` y llenalo. `.env.local` NO se sube a
#  git; este ejemplo SÍ, y por eso nunca lleva un valor real adentro.
#
#  En el VPS NO hay archivo .env: las variables se pasan como banderas `-e` en
#  `/root/deploy-site-tls.sh`, que es el script que recrea el contenedor.
# ============================================================================

# ----------------------------------------------------------------------------
# URL pública del sitio, con https y SIN barra final.
# La usan el canonical, el Open Graph, el JSON-LD, sitemap.xml y robots.txt.
# Si se deja vacía, el sitio usa el respaldo de lib/site-url.ts y Google podría
# terminar indexando un dominio que no es. En producción NO la dejes vacía.
#   En producción: https://desamparadostech.com
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------------------------
# FLUJO B de n8n — Captura de leads.
# URL del nodo `Webhook (POST)` del flujo que guarda el lead (Sheets / Airtable
# / Notion) y le avisa al estudio. Lo consume `app/api/lead/route.ts`.
#
# Es SECRETA: no lleva prefijo NEXT_PUBLIC_, así que nunca llega al navegador.
# Si se deja vacía, el formulario sigue funcionando: el lead queda en los logs
# de Vercel y la clienta igual termina en WhatsApp con todo el contexto.
#   ej. https://n8n.tudominio.com/webhook/aura-lead
# ----------------------------------------------------------------------------
N8N_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# FLUJO A de n8n — Consulta de disponibilidad.
# URL del nodo `Webhook (GET)` del flujo que consulta Google Calendar FreeBusy y
# devuelve los espacios libres. Lo consume `app/api/availability/route.ts`.
#
# También SECRETA. Si se deja vacía, el endpoint devuelve los espacios que
# permite el horario de config/site.ts marcados como `degraded: true`, para
# poder ver y probar la UI sin backend levantado.
#   ej. https://n8n.tudominio.com/webhook/aura-disponibilidad
# ----------------------------------------------------------------------------
N8N_AVAILABILITY_URL=

# ----------------------------------------------------------------------------
# CONTRASEÑA DEL PANEL (/manager y /api/manager/*).
#
# Es la llave de la moderación de reseñas y de todo el panel. `middleware.ts`
# FALLA CERRADO: si esta variable está vacía, el panel pide clave y no la acepta
# nunca — nadie entra, ni siquiera Génesis. Es a propósito: un panel sin clave
# es peor que un panel inaccesible.
#
# El usuario es fijo ("genesis"); acá va sólo la contraseña.
# ----------------------------------------------------------------------------
MANAGER_PASSWORD=

# ----------------------------------------------------------------------------
# Sal para el hash de las IP de las reseñas. Cualquier cadena larga y aleatoria.
#   ej. openssl rand -hex 32
#
# Si se deja vacía NO hay problema de seguridad: `lib/resenas.ts` se inventa una
# al azar al arrancar. Ponerla sirve para que las huellas sobrevivan a un
# reinicio del contenedor, y con eso el límite de 3 reseñas por hora también.
#
# Lo que NUNCA hay que hacer es poner acá algo corto o adivinable: sólo hay unos
# 4 mil millones de IPv4, así que con una sal débil los hashes se revierten por
# fuerza bruta y el archivo de cada reseña pasa a decir desde qué IP se escribió.
# ----------------------------------------------------------------------------
RESENAS_SAL=
